{
  "id": "conveyor.chain",
  "version": "0.1.0",
  "category": "conveyors",
  "name": {
    "en": "Chain conveyor"
  },
  "description": {
    "en": "Straight section of synchronised chain strands; EUR pallets travel transversely (short side first)."
  },
  "parameters": [
    {
      "key": "length",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 3.0,
      "min": 0.5,
      "max": 12.0,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Length"
      },
      "description": {
        "en": "Length in the direction of travel"
      }
    },
    {
      "key": "usableWidth",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 1.3,
      "min": 0.5,
      "max": 1.8,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Usable width"
      },
      "description": {
        "en": "Clear width; must be ≥ 1200 mm + 2 × clearance for a transverse EUR (proposed, to confirm)"
      }
    },
    {
      "key": "surfaceHeight",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.6,
      "min": 0.2,
      "max": 1.5,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Surface height"
      },
      "description": {
        "en": "Height of the pallet support plane above the floor"
      }
    },
    {
      "key": "palletSideAlongTravel",
      "type": "enum",
      "default": "short",
      "options": [
        "long",
        "short"
      ],
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Pallet side along travel"
      },
      "description": {
        "en": "Which pallet side is parallel to the direction of travel"
      }
    },
    {
      "key": "nominalSpeed",
      "type": "number",
      "unit": "m/s",
      "displayUnit": "m/s",
      "default": 0.25,
      "min": 0.05,
      "max": 0.6,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Nominal speed"
      },
      "description": {
        "en": "Cruise speed"
      }
    },
    {
      "key": "accel",
      "type": "number",
      "unit": "m/s²",
      "displayUnit": "m/s²",
      "default": 0.5,
      "min": 0.05,
      "max": 2.0,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Acceleration"
      },
      "description": {
        "en": "Start-up ramp"
      }
    },
    {
      "key": "decel",
      "type": "number",
      "unit": "m/s²",
      "displayUnit": "m/s²",
      "default": 0.5,
      "min": 0.05,
      "max": 2.0,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Deceleration"
      },
      "description": {
        "en": "Stopping ramp"
      }
    },
    {
      "key": "direction",
      "type": "enum",
      "default": "forward",
      "options": [
        "forward",
        "reverse",
        "reversible"
      ],
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Direction"
      },
      "description": {
        "en": "Direction of travel"
      }
    },
    {
      "key": "chainCount",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 6,
      "group": "chains",
      "affects": "both",
      "label": {
        "en": "Number of chain strands"
      },
      "description": {
        "en": "Number of synchronised strands"
      }
    },
    {
      "key": "chainSupportWidth",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.04,
      "min": 0.02,
      "max": 0.1,
      "group": "chains",
      "affects": "both",
      "label": {
        "en": "Chain support width"
      },
      "description": {
        "en": "Contact width of each strand"
      }
    },
    {
      "key": "chainType",
      "type": "enum",
      "default": "roller",
      "options": [
        "simple",
        "roller",
        "doublePitch"
      ],
      "group": "chains",
      "affects": "3d",
      "label": {
        "en": "Chain type"
      },
      "description": {
        "en": "Friction and support geometry"
      }
    },
    {
      "key": "chainPitch",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.0381,
      "min": 0.01905,
      "max": 0.0762,
      "group": "chains",
      "affects": "3d",
      "advanced": true,
      "label": {
        "en": "Chain pitch"
      },
      "description": {
        "en": "Chain pitch; geometry and polygon effect in 3D"
      }
    },
    {
      "key": "chainMu",
      "type": "number",
      "default": 0.3,
      "min": 0.1,
      "max": 0.6,
      "group": "chains",
      "affects": "3d",
      "label": {
        "en": "Chain friction μ"
      },
      "description": {
        "en": "Pallet–chain friction coefficient"
      }
    },
    {
      "key": "accumulationMode",
      "type": "enum",
      "default": "none",
      "options": [
        "none",
        "slip",
        "zoned"
      ],
      "group": "accumulation",
      "affects": "both",
      "label": {
        "en": "Accumulation mode"
      },
      "description": {
        "en": "none: every pallet moves with the chains and the conveyor runs and stops as one unit; slip: chains slide under held pallets; zoned: independent zones"
      }
    },
    {
      "key": "minGap",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.15,
      "min": 0.05,
      "max": 0.5,
      "group": "accumulation",
      "affects": "both",
      "label": {
        "en": "Minimum gap"
      },
      "description": {
        "en": "Minimum clearance between accumulated pallets"
      }
    },
    {
      "key": "zoneLength",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 1.4,
      "min": 1.0,
      "max": 2.0,
      "group": "accumulation",
      "affects": "both",
      "dependsOn": "accumulationMode=zoned",
      "label": {
        "en": "Zone length"
      },
      "description": {
        "en": "Zoned mode only"
      }
    },
    {
      "key": "stopContactTime",
      "type": "number",
      "unit": "s",
      "displayUnit": "s",
      "default": 0.2,
      "min": 0.05,
      "max": 1,
      "group": "accumulation",
      "affects": "2d",
      "dependsOn": "accumulationMode=slip",
      "label": {
        "en": "Stop contact time"
      },
      "description": {
        "en": "2D: time for the pallet to stop at a stop (slip mode)"
      }
    },
    {
      "key": "maxPalletLoad",
      "type": "number",
      "unit": "kg",
      "displayUnit": "kg",
      "default": 1000,
      "min": 100,
      "max": 2000,
      "group": "load",
      "affects": "both",
      "label": {
        "en": "Max pallet load"
      },
      "description": {
        "en": "Warns when a pallet (with its load) exceeds this mass"
      }
    },
    {
      "key": "driveSide", "type": "enum", "options": ["right", "left"],
      "default": "right", "group": "drive", "affects": "geometry",
      "label": { "en": "Drive side", "es": "Lado del accionamiento", "de": "Antriebsseite" },
      "description": { "en": "Side of the drive and of the chain guard, seen in the direction of travel (drawing only)", "es": "Lado del accionamiento y del protector de cadena, mirando en el sentido del avance (solo dibujo)", "de": "Seite des Antriebs und des Kettenschutzes in Förderrichtung gesehen (nur Darstellung)" }
    },
    {
      "key": "drivePosition", "type": "enum", "options": ["centre", "end"],
      "default": "centre", "group": "drive", "affects": "geometry",
      "label": { "en": "Drive position", "es": "Posición del accionamiento", "de": "Antriebsposition" },
      "description": { "en": "Centre drive (the chains loop down around the drive sprockets mid-length) or head drive at the end (drawing only)", "es": "Accionamiento central (las cadenas bajan a los piñones motrices a mitad de longitud) o de cabeza en el extremo (solo dibujo)", "de": "Mittenantrieb (die Ketten laufen in der Mitte um die Antriebsräder nach unten) oder Kopfantrieb am Ende (nur Darstellung)" }
    },
    {
      "key": "sideGuard", "type": "enum", "options": ["none", "right", "left", "both"],
      "default": "none", "group": "guides", "affects": "geometry",
      "label": { "en": "Side guard", "es": "Guía lateral de protección", "de": "Seitenschutz" },
      "description": { "en": "Rail on posts outside the outer strand at the height of the pallet side; guides mesh boxes and plastic pallets (drawing only)", "es": "Barandilla sobre postes por fuera del ramal exterior a la altura del costado del pallet; guía jaulas y pallets de plástico (solo dibujo)", "de": "Geländer auf Pfosten außerhalb des äußeren Strangs in Höhe der Palettenseite; führt Gitterboxen und Kunststoffpaletten (nur Darstellung)" }
    },
    {
      "key": "endStop", "type": "boolean",
      "default": false, "group": "geometry", "affects": "geometry",
      "label": { "en": "End stop", "es": "Tope final", "de": "Endanschlag" },
      "description": { "en": "Fixed plate at the free end of a line so that pallets cannot run off (drawing only; in 2D a pallet always stops at an open end)", "es": "Placa fija en el extremo libre de una línea para que los pallets no se salgan (solo dibujo; en 2D un pallet siempre se para en un extremo abierto)", "de": "Feste Platte am freien Ende einer Linie, damit Paletten nicht herunterfahren (nur Darstellung; in 2D hält eine Palette an einem offenen Ende immer an)" }
    }
  ],
  "ports": [
    {
      "id": "A",
      "direction": "in",
      "facing": "-x",
      "local": {
        "x": 0,
        "y": "surfaceHeight",
        "z": 0
      }
    },
    {
      "id": "B",
      "direction": "out",
      "facing": "+x",
      "local": {
        "x": "length",
        "y": "surfaceHeight",
        "z": 0
      }
    }
  ],
  "signals": {
    "inputs": [
      "run",
      "reverse",
      "enable"
    ],
    "outputs": [
      "running",
      "occupied"
    ]
  },
  "statistics": [
    "utilization",
    "blockedTime",
    "emptyTime",
    "palletsProcessed",
    "throughputPerHour",
    "meanTransitTime",
    "meanOccupancy"
  ],
  "geometry": "geom.chain_conveyor",
  "behaviors": {
    "des": "des.chain_conveyor",
    "physics": "phys.chain_conveyor"
  },
  "validationRules": [
    "usableWidthFitsPallet"
  ],
  "presets": []
}
