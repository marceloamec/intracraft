{
  "id": "conveyor.chain",
  "version": "0.1.0",
  "category": "conveyors",
  "name": {
    "en": "Chain conveyor"
  },
  "description": {
    "en": "Straight section of synchronised chain strands; EUR pallets travel transversely (short side first)."
  },
  "parameters": [
    {
      "key": "length",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 3.0,
      "min": 0.5,
      "max": 12.0,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Length"
      },
      "description": {
        "en": "Length in the direction of travel"
      }
    },
    {
      "key": "usableWidth",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 1.3,
      "min": 0.5,
      "max": 1.8,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Usable width"
      },
      "description": {
        "en": "Clear width; must be ≥ 1200 mm + 2 × clearance for a transverse EUR (proposed, to confirm)"
      }
    },
    {
      "key": "surfaceHeight",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.6,
      "min": 0.2,
      "max": 1.5,
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Surface height"
      },
      "description": {
        "en": "Height of the pallet support plane above the floor"
      }
    },
    {
      "key": "palletSideAlongTravel",
      "type": "enum",
      "default": "short",
      "options": [
        "long",
        "short"
      ],
      "group": "geometry",
      "affects": "both",
      "label": {
        "en": "Pallet side along travel"
      },
      "description": {
        "en": "Which pallet side is parallel to the direction of travel"
      }
    },
    {
      "key": "nominalSpeed",
      "type": "number",
      "unit": "m/s",
      "displayUnit": "m/s",
      "default": 0.25,
      "min": 0.05,
      "max": 0.6,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Nominal speed"
      },
      "description": {
        "en": "Cruise speed"
      }
    },
    {
      "key": "accel",
      "type": "number",
      "unit": "m/s²",
      "displayUnit": "m/s²",
      "default": 0.5,
      "min": 0.05,
      "max": 2.0,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Acceleration"
      },
      "description": {
        "en": "Start-up ramp"
      }
    },
    {
      "key": "decel",
      "type": "number",
      "unit": "m/s²",
      "displayUnit": "m/s²",
      "default": 0.5,
      "min": 0.05,
      "max": 2.0,
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Deceleration"
      },
      "description": {
        "en": "Stopping ramp"
      }
    },
    {
      "key": "direction",
      "type": "enum",
      "default": "forward",
      "options": [
        "forward",
        "reverse",
        "reversible"
      ],
      "group": "motion",
      "affects": "both",
      "label": {
        "en": "Direction"
      },
      "description": {
        "en": "Direction of travel"
      }
    },
    {
      "key": "chainCount",
      "type": "integer",
      "default": 3,
      "min": 2,
      "max": 6,
      "group": "chains",
      "affects": "both",
      "label": {
        "en": "Number of chain strands"
      },
      "description": {
        "en": "Number of synchronised strands"
      }
    },
    {
      "key": "chainSupportWidth",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.04,
      "min": 0.02,
      "max": 0.1,
      "group": "chains",
      "affects": "both",
      "label": {
        "en": "Chain support width"
      },
      "description": {
        "en": "Contact width of each strand"
      }
    },
    {
      "key": "chainType",
      "type": "enum",
      "default": "roller",
      "options": [
        "simple",
        "roller",
        "doublePitch"
      ],
      "group": "chains",
      "affects": "3d",
      "label": {
        "en": "Chain type"
      },
      "description": {
        "en": "Friction and support geometry"
      }
    },
    {
      "key": "chainPitch",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.0381,
      "min": 0.01905,
      "max": 0.0762,
      "group": "chains",
      "affects": "3d",
      "advanced": true,
      "label": {
        "en": "Chain pitch"
      },
      "description": {
        "en": "Chain pitch; geometry and polygon effect in 3D"
      }
    },
    {
      "key": "chainMu",
      "type": "number",
      "default": 0.3,
      "min": 0.1,
      "max": 0.6,
      "group": "chains",
      "affects": "3d",
      "label": {
        "en": "Chain friction μ"
      },
      "description": {
        "en": "Pallet–chain friction coefficient"
      }
    },
    {
      "key": "accumulationMode",
      "type": "enum",
      "default": "none",
      "options": [
        "none",
        "slip",
        "zoned"
      ],
      "group": "accumulation",
      "affects": "both",
      "label": {
        "en": "Accumulation mode"
      },
      "description": {
        "en": "none: every pallet moves with the chains and the conveyor runs and stops as one unit; slip: chains slide under held pallets; zoned: independent zones"
      }
    },
    {
      "key": "minGap",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 0.15,
      "min": 0.05,
      "max": 0.5,
      "group": "accumulation",
      "affects": "both",
      "label": {
        "en": "Minimum gap"
      },
      "description": {
        "en": "Minimum clearance between accumulated pallets"
      }
    },
    {
      "key": "zoneLength",
      "type": "number",
      "unit": "m",
      "displayUnit": "mm",
      "default": 1.4,
      "min": 1.0,
      "max": 2.0,
      "group": "accumulation",
      "affects": "both",
      "dependsOn": "accumulationMode=zoned",
      "label": {
        "en": "Zone length"
      },
      "description": {
        "en": "Zoned mode only"
      }
    },
    {
      "key": "stopContactTime",
      "type": "number",
      "unit": "s",
      "displayUnit": "s",
      "default": 0.2,
      "min": 0.05,
      "max": 1,
      "group": "accumulation",
      "affects": "2d",
      "dependsOn": "accumulationMode=slip",
      "label": {
        "en": "Stop contact time"
      },
      "description": {
        "en": "2D: time for the pallet to stop at a stop (slip mode)"
      }
    },
    {
      "key": "maxPalletLoad",
      "type": "number",
      "unit": "kg",
      "displayUnit": "kg",
      "default": 1000,
      "min": 100,
      "max": 2000,
      "group": "load",
      "affects": "both",
      "label": {
        "en": "Max pallet load"
      },
      "description": {
        "en": "Warns when a pallet (with its load) exceeds this mass"
      }
    }
  ],
  "ports": [
    {
      "id": "A",
      "direction": "in",
      "facing": "-x",
      "local": {
        "x": 0,
        "y": "surfaceHeight",
        "z": 0
      }
    },
    {
      "id": "B",
      "direction": "out",
      "facing": "+x",
      "local": {
        "x": "length",
        "y": "surfaceHeight",
        "z": 0
      }
    }
  ],
  "signals": {
    "inputs": [
      "run",
      "reverse",
      "enable"
    ],
    "outputs": [
      "running",
      "occupied"
    ]
  },
  "statistics": [
    "utilization",
    "blockedTime",
    "emptyTime",
    "palletsProcessed",
    "throughputPerHour",
    "meanTransitTime",
    "meanOccupancy"
  ],
  "geometry": "geom.chain_conveyor",
  "behaviors": {
    "des": "des.chain_conveyor",
    "physics": "phys.chain_conveyor"
  },
  "validationRules": [
    "usableWidthFitsPallet"
  ],
  "presets": []
}
